### Build output ###
target/
build/
*.class
*.jar
*.war

# WHY these negations: the patterns above are broad, and a project may legitimately
# contain a source folder literally named target/ or build/. These exceptions keep
# real source under src/ tracked even when it matches.
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# WHY: Maven 3.9's wrapper downloads its own jar on first run rather than having it
# committed, so the jar is generated output rather than source.
.mvn/wrapper/maven-wrapper.jar

### Local infrastructure state ###
# WHY: container volumes for Postgres, Kafka, and Elasticsearch land here. This is
# regenerable local state, often hundreds of megabytes, and must never be committed.
infra/data/

### Secrets ###
# WHY default-deny: .env files conventionally carry credentials, so every one is
# ignored unless deliberately allowed below.
.env
*.env

# WHY this exception: infra/.env holds only COMPOSE_PROFILES, which selects which
# containers start. It is configuration rather than a secret, and it must be
# committed so the environment is reproducible for anyone cloning the repository.
!infra/.env

*.pem
*.key
*.p12

### IDEs ###
.idea/
*.iws
*.iml
*.ipr
.vscode/

# Eclipse / Spring Tool Suite
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

### Operating system ###
.DS_Store
Thumbs.db

