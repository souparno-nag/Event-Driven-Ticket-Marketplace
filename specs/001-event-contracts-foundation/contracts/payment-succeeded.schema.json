{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace.local/schemas/payment-succeeded.schema.json",
  "title": "PaymentSucceeded",
  "description": "Funds were collected. Simulated in this project: payment declines when the last minor-unit digit of the amount is 7.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "messageId": {
      "$ref": "envelope.schema.json#/properties/messageId"
    },
    "sagaId": {
      "$ref": "envelope.schema.json#/properties/sagaId"
    },
    "occurredAt": {
      "$ref": "envelope.schema.json#/properties/occurredAt"
    },
    "schemaVersion": {
      "$ref": "envelope.schema.json#/properties/schemaVersion"
    },
    "orderId": {
      "type": "string",
      "format": "uuid",
      "description": "The order this message concerns. Always equal to sagaId."
    },
    "paymentId": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "Decimal string with exactly 2 places. A string, not a number, so it is never parsed as a lossy double."
    }
  },
  "required": [
    "messageId",
    "sagaId",
    "occurredAt",
    "schemaVersion",
    "orderId",
    "paymentId",
    "amount"
  ]
}
