<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  WHY the parent is ticket-marketplace and not spring-boot-starter-parent:
	  the generated project inherited Boot directly, which pins its own Boot version and
	  ignores this project's. Inheriting the aggregator instead means the Boot version,
	  the Java version, and the Surefire/Failsafe test wiring are all decided in exactly
	  one place — the root pom — and every service module gets the same answer.

	  Initializr produced Boot 4.0.8. This project is on 3.3.13, chosen because Spring
	  Cloud 2023.0.x (Eureka and Gateway, build step 7) is a verified pairing with Boot
	  3.3 and no such pairing is verified for 4.x. Swapping the parent alone was not
	  enough: Boot 4 RENAMED most starters, so every dependency below had to be
	  rewritten to its 3.3 name. See the notes on each.
	-->
	<parent>
		<groupId>com.marketplace</groupId>
		<artifactId>ticket-marketplace</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>order-service</artifactId>
	<name>order-service</name>
	<description>Accepts booking requests and publishes them through a transactional outbox</description>

	<!--
	  No <properties> block: java.version and project.build.sourceEncoding are inherited
	  from the root. Repeating them here is how two modules quietly end up on different
	  Java versions.
	-->

	<dependencies>
		<!--
		  THE CONTRACT MODULE. Every message this service publishes is defined here, and
		  so are the channel names it publishes them to. Depending on it is what makes a
		  wrong topic name a compile error instead of messages written into a channel
		  nobody reads (Topics.java, build step 1).
		-->
		<dependency>
			<groupId>com.marketplace</groupId>
			<artifactId>common-events</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- Boot 4 calls this spring-boot-starter-webmvc. On 3.3 it is -web. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Serves /actuator/health and /actuator/prometheus (FR-024). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
		  Boot 4 offers spring-boot-starter-kafka. On 3.3 there is no such starter — the
		  dependency is Spring Kafka itself, whose version the root parent still manages.
		-->
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>

		<!--
		  Boot 4 offers spring-boot-starter-flyway. On 3.3 you declare flyway-core.
		  flyway-database-postgresql is NOT optional despite looking like it: Flyway 10
		  moved every database into its own module, and without this one Flyway starts
		  and then fails at runtime with "Unsupported Database: PostgreSQL 16".
		-->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- runtime scope: the driver is loaded by name, never referenced in our code. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
		  TRACING. Two halves that are easy to confuse:
		    micrometer-tracing-bridge-brave  CREATES spans and propagates W3C traceparent
		    zipkin-reporter-brave            SHIPS finished spans to Zipkin
		  Only the first is load-bearing for this step. The outbox stores the traceparent
		  on each row so the relay can continue the accepting request's trace minutes
		  later (FR-025, FR-026); that works whether or not Zipkin is running. The
		  reporter is what makes the result visible in the UI at localhost:9411.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-brave</artifactId>
		</dependency>
		<dependency>
			<groupId>io.zipkin.reporter2</groupId>
			<artifactId>zipkin-reporter-brave</artifactId>
		</dependency>

		<!--
		  Declared explicitly rather than left as a transitive dependency, because TracingConfig
		  imports its classes directly. It was already on the classpath either way, pulled in
		  transitively by micrometer-tracing-bridge-brave; Spring Boot's own autoconfiguration
		  just never assembles it into a working Propagator bean in this version (see
		  TracingConfig's javadoc). No version is managed for this artifact by Spring Boot's BOM,
		  so it is pinned here to the exact version already resolving transitively.
		-->
		<dependency>
			<groupId>io.zipkin.contrib.brave-propagation-w3c</groupId>
			<artifactId>brave-propagation-tracecontext</artifactId>
			<version>0.2.0</version>
		</dependency>

		<!-- Turns the actuator's metrics into the Prometheus scrape format. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!--
		  Cuts the getters off the entities. Deliberately NOT @Data, @EqualsAndHashCode or
		  @ToString on a JPA entity: the generated equals/hashCode fold in the identifier, so
		  an entity's hash code CHANGES after persist and silently corrupts any hash-based
		  collection already holding it, and the generated toString walks lazy associations,
		  producing surprise queries or LazyInitializationException. @Getter and @Setter carry
		  none of that risk.

		  `optional` stops Lombok leaking onto the classpath of anything that depends on this
		  module. It is a compile-time code generator; nothing needs it at runtime.
		-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!--
		  Boot 4 splits testing into per-slice starters (spring-boot-starter-web-test and
		  friends). On 3.3 there is one starter carrying JUnit 5, AssertJ, Mockito and
		  the Spring test context.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
		  WHY real containers rather than an embedded database and an embedded broker:
		  everything this service must be trusted about is behaviour the real products
		  provide and the fakes do not — FOR UPDATE SKIP LOCKED, partial indexes, JSONB,
		  and per-partition message ordering. H2 would answer questions about H2.
		-->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>kafka</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
		  The relay is scheduled, so its effects arrive after the call that triggered
		  them returns. Awaitility polls for a condition with a timeout; the alternative
		  is Thread.sleep, which is either too short and flaky or too long and slow.
		-->
		<dependency>
			<groupId>org.awaitility</groupId>
			<artifactId>awaitility</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
			  Declared HERE and deliberately not at the root. This plugin repackages the
			  jar into an executable fat jar with a nested classloader — correct for a
			  service, wrong for common-events, which other modules depend on. Each
			  service module opts in for itself.
			-->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
